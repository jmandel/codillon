  "  call $isqrt_harness",
  ")",
  "(func $sq_le (param $r i64) (param $n i64) (result i32)",
  "  local.get $r",
  "  local.get $r",
  "  i64.mul",
  "  local.get $n",
  "  i64.le_u",
  ")",
  "(func $is_isqrt (param $r i64) (param $n i64) (result i32)",
  "  local.get $r",
  "  local.get $n",
  "  call $sq_le",
  "  if (result i32)",
  "    local.get $n",
  "    local.get $r",
  "    i64.const 1",
  "    i64.add",
  "    local.get $r",
  "    i64.const 1",
  "    i64.add",
  "    i64.mul",
  "    i64.lt_u",
  "  else",
  "    i32.const 0",
  "  end",
  ")",
  "(func $isqrt (export \"isqrt\") (param $n i32) (result (i32 | (call $is_isqrt (i64.extend_i32_u v) (i64.extend_i32_u $n))))",
  "  i32.const 0",
  ")",
  "(func $isqrt_harness (export \"harness:isqrt\") (param $n i32)",
  "  local.get $n",
  "  call $isqrt",
  "  i64.extend_i32_u",
  "  local.get $n",
  "  i64.extend_i32_u",
  "  call $is_isqrt",
  "  br_if 0",
  "  prove 2",
  "  unreachable",
  ")"
